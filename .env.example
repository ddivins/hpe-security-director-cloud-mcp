# Base URL of the Security Director Cloud API. Defaults to the production endpoint if unset.
SDCLOUD_BASE_URL=https://api.sdcloud.juniperclouds.net/

# Provide exactly one of the following credentials.
# If both are set, SDCLOUD_OAUTH_TOKEN takes precedence.
SDCLOUD_API_KEY=
SDCLOUD_OAUTH_TOKEN=

# Audit logging configuration (optional).
# SDCLOUD_LOG_DIR: Directory for audit logs. Defaults to ./logs
# SDCLOUD_LOG_LEVEL: Log verbosity. Options: 'info' (default), 'debug'
# SDCLOUD_LOG_HMAC_KEY: HMAC key for hashing sensitive data. Change in production.
SDCLOUD_LOG_DIR=./logs
SDCLOUD_LOG_LEVEL=info
SDCLOUD_LOG_HMAC_KEY=change-this-in-production-use-a-strong-secret
